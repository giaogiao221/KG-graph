# Extraction review platform — deployment environment template.
# Copy to `.env` (never commit the copy) and fill in freshly generated values:
#   cp .env.example .env
# Then pass it to every compose command:
#   docker compose --env-file .env -f deploy/docker-compose.yml <command>

# --- Required secrets -------------------------------------------------------
# Generate each value independently, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# JWT signing secret, at least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EXTRACTION_JWT_SECRET=

# Master key for encrypting stored model API credentials:
# base64-encoded 32 random bytes.
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
EXTRACTION_MODEL_MASTER_KEY=

# HMAC key (at least 32 characters) protecting the worker-side model result
# cache from tampering.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EXTRACTION_CACHE_HMAC_KEY=

# --- Initial administrator bootstrap ---------------------------------------
# Consumed once by `python -m app.auth.bootstrap` (see docs/operations.md).
# The password must be at least 12 characters. Prefer clearing these values
# (or using the interactive prompt) after the account exists.
EXTRACTION_BOOTSTRAP_ADMIN_USERNAME=admin
EXTRACTION_BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Host port for the web UI (container port is always 80).
# HTTP_PORT=8080

# Optional minio profile credentials (only used with `--profile minio`).
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# Playwright end-to-end acceptance (see docs/operations.md).
# E2E_BASE_URL=http://localhost:8080
